# AI Configuration
AI_PROVIDER=google # Options: google, anthropic

# Google Gemini
GEMINI_API_KEY=your_key_here

# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Model Configuration (Defaults to gemini-2.0-flash)
REGIME_AGENT_MODEL=gemini-2.0-flash
REBALANCING_AGENT_MODEL=gemini-2.0-flash
COHERENCE_AGENT_MODEL=gemini-2.0-flash
INTERPRETER_AGENT_MODEL=gemini-2.0-flash

# FRED
FRED_API_KEY=your_key_here

# IBKR Flex Web Service (Used by ibkrFetcher.ts)
IBKR_FLEX_TOKEN=your_token_here
IBKR_FLEX_QUERY_ID=your_query_id_here

# IBKR TWS/Gateway (Aspirational/TWS API)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497         # 7497 = paper, 7496 = live
IBKR_CLIENT_ID=1

# Polygon.io
POLYGON_API_KEY=your_key_here

# EIA
EIA_API_KEY=your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
